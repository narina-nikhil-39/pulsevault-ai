# SynapseHealth Environment Variables Template
# Copy this file to .env and fill in production keys

# AI / LLM Credentials (server-side only — never exposed to the browser)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Clinical Terminology Services (free, no signup required)
OPENFDA_BASE_URL=https://api.fda.gov
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST

# Local Storage
DATABASE_URL=sqlite:///./data/synapsehealth.db
UPLOAD_DIR=./data/uploads

# Server & Security Configuration
AUTH_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development