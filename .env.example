# =============================================================================
# SynapseHealth (PulseVault AI) — Environment Configuration Template
# Copy this file to .env and configure keys for your target environment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AI & Multimodal LLM Extraction (Google Gemini)
# -----------------------------------------------------------------------------
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 2. Relational Database (SQLAlchemy / PostgreSQL / SQLite)
# -----------------------------------------------------------------------------
# For Local SQLite (Default development mode):
DATABASE_URL=sqlite:///./data/synapsehealth.db

# For Production Docker Compose (PostgreSQL 16):
# DATABASE_URL=postgresql://synapse:synapse_secret_2026@postgres:5432/synapsehealth
POSTGRES_PASSWORD=synapse_secret_2026

# Document Storage Directory
UPLOAD_DIR=./data/uploads

# -----------------------------------------------------------------------------
# 3. Clinical Knowledge Graph (Neo4j Community)
# -----------------------------------------------------------------------------
# For Local / Offline Simulated mode, leave empty or point to localhost:
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=synapsehealth

# In Docker Compose, the API automatically connects to:
# NEO4J_URI=bolt://neo4j:7687

# -----------------------------------------------------------------------------
# 4. Vector Database (Qdrant Semantic Embeddings)
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# In Docker Compose:
# QDRANT_URL=http://qdrant:6333

# -----------------------------------------------------------------------------
# 5. Clinical Terminology Services (OpenFDA & NLM RxNav)
# -----------------------------------------------------------------------------
# Public REST endpoints (No API key required)
OPENFDA_BASE_URL=https://api.fda.gov
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST

# -----------------------------------------------------------------------------
# 6. Security, Authentication & Ephemeral JWTs
# -----------------------------------------------------------------------------
# Secret used for signing Doctor bearer tokens and Break-Glass 60-minute emergency JWTs
AUTH_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production

# Server Host & Port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production